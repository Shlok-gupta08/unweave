{
  "name": "unweave",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && .venv/bin/python -m uvicorn main:app --reload --port 8010",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "install:all": "npm install --prefix frontend && npm install --prefix desktop && cd backend && .venv/bin/pip install -r requirements.txt",
    "desktop:dev": "npm start --prefix desktop",
    "desktop:dmg": "bash scripts/package-mac.sh",
    "desktop:app": "bash scripts/package-mac.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
